    "ramanujan_II_continued_fraction_periodicity": {
      "description": "Stieltjes continued fraction of 2F1(-1/2, -1/2; 1; h) - 1 has identical 3rd and 4th partial numerators a_3 == a_4 == 3/16, explaining why closing at depth 3 with a 1-periodic radical T = (2 + sqrt(4 - 3*h))/4 matches 4 Taylor orders with 3 parameters (also derived independently by U. Shankar, arXiv:2603.03373, Mar 2026).",
      "stieltjes_coefficients_a1_to_a7": ["1/4", "1/16", "3/16", "3/16", "11/48", "115/528", "14627/60720"]
    },
    "inner_radical_reciprocal_expansion_2d": {
      "description": "Exact reciprocal Taylor expansion of the defect delta(h) inside Ramanujan's square root sqrt(4 - 3*h - delta(h)).",
      "identity_sympy": "27*h**4 / delta(h) = 6144 - 7040*h + (5144/3)*h**2 - (413/9)*h**3 - (1081/108)*h**4 + O(h**5)",
      "exact_boundary_constant_delta1": {
        "expression": "1 - (3*pi/(4 - pi) - 10)**2",
        "decimal_50dps": "0.040820498000447233126918157747460650548103321534727",
        "reciprocal_27_over_delta1": "661.43240093994408199240107718923049932777610255651"
      }
    },
    "carlson_3d_spherical_invariant_series": {
      "description": "Exact 3D surface area expansion S(a,b,c)/(4*pi*M) = R_G(X^2, Y^2, Z^2)/M in symmetric trace-free invariants H = (x^2+y^2+z^2)/6 and J = x*y*z, where X=a*b, Y=a*c, Z=b*c, M=(X+Y+Z)/3.",
      "series_sympy_degree_10": "1 + (3/5)*H - (3/35)*J + (3/35)*H**2 - (6/385)*H*J + (171/5005)*H**3 - (3/715)*J**2 - (3/1001)*H**2*J - (57/17017)*H*J**2 + (27/1547)*H**4 - (15/46189)*J**3 + (36/46189)*H**3*J - (6/2717)*H**2*J**2 + (27/2717)*H**5",
      "exact_3d_to_2d_boundary_theorem": "On the entire degenerate 3D boundary Z = b*c -> 0 (where 1 - 3*H + J = (a*b*c)^2 / M^3 = 0), S(a,b,c) == (pi/2) * C_2D(a*b, a*c) identically."
    }
  },
